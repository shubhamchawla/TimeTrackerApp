<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- For more information on data extraction rules, see https://developer.android.com/guide/topics/data/autobackup#Rules -->
    <cloud-backup>
        <exclude domain="database" path="-journal"/>
        <exclude domain="database" path="-shm"/>
        <exclude domain="database" path="-wal"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="-journal"/>
        <exclude domain="database" path="-shm"/>
        <exclude domain="database" path="-wal"/>
    </device-transfer>
</data-extraction-rules>